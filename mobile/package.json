{
  "name": "flexpay",
  "version": "1.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "eslint-config-expo": "~57.0.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "export:android": "expo export --platform android --output-dir dist-android",
    "export:web": "expo export --platform web",
    "build:android": "npx eas-cli@latest build --platform android --profile preview",
    "build:development": "npx eas-cli@latest build --platform android --profile development"
  },
  "private": true
}
