{
  "name": "flexpay",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.26",
    "expo-dev-client": "~57.0.19",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "eslint-config-expo": "~57.0.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "export:android": "expo export --platform android --output-dir dist-android",
    "export:web": "expo export --platform web",
    "build:android": "npx eas-cli@latest build --platform android --profile preview",
    "build:development": "npx eas-cli@latest build --platform android --profile development"
  },
  "private": true
}
